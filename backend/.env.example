# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_USE_VERTEX=true

# CORS
CORS_ALLOW_ORIGINS=http://localhost:3000

# MS-SQL (매출 뷰 SELECT 전용 계정 사용 권장)
MSSQL_SERVER=your-db-server,1433
MSSQL_DATABASE=your-database
MSSQL_READONLY_USER=your-readonly-user
MSSQL_READONLY_PASSWORD=your-readonly-password
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERTIFICATE=no

# 이메일 리포트 발송(옵셔널) — SMTP_HOST와 ALLOWED_EMAIL_DOMAINS를 둘 다 설정해야
# /api/report/email이 활성화된다. 미설정 상태면 이메일 기능은 503으로 비활성화되고
# /api/chat, /api/report/pdf 등 나머지 기능에는 영향이 없다.
SMTP_HOST=smtp.company.com
SMTP_PORT=587
SMTP_USER=erp-bot@company.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=erp-bot@company.com
SMTP_USE_TLS=true
# 콤마로 구분된 사내 도메인 화이트리스트. 서브도메인도 자동 허용된다(예: mail.company.com).
# 기본값은 빈 문자열(=전부 거부)이므로 실제 사용 시 반드시 지정해야 한다.
ALLOWED_EMAIL_DOMAINS=company.com
# 콤마로 구분된 "자주 쓰는 수신자" 추천 목록(옵셔널). 발송 UI가 GET /api/report/email/presets로
# 읽어와 빠른 선택지로 보여준다. 추천일 뿐이므로 여기 없는 주소도 발송 가능하며,
# 반대로 여기 있어도 ALLOWED_EMAIL_DOMAINS를 통과하지 못하면 발송은 거부된다.
EMAIL_PRESET_RECIPIENTS=sales@company.com,manager@company.com
